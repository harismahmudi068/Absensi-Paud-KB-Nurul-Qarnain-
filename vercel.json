{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/guru.js": {
      "maxDuration": 60
    },
    "api/notif-siswa.js": {
      "maxDuration": 30
    },
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/pengaturan.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/p/:kode",
      "destination": "/portal.html"
    }
  ],
  "headers": [
    {
      "source": "/p/:kode",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
