{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/guru.js": {
      "maxDuration": 60
    },
    "api/notif-siswa.js": {
      "maxDuration": 30
    },
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/pengaturan.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/p/:kode",
      "destination": "/portal.html"
    },
    {
      "source": "/pwa-portal.js",
      "destination": "/js/pwa-portal.js"
    },
    {
      "source": "/kartu.js",
      "destination": "/js/kartu.js"
    },
    {
      "source": "/rapor.js",
      "destination": "/js/rapor.js"
    }
  ],
  "headers": [
    {
      "source": "/p/:kode",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
